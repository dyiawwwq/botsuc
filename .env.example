# Copy this file to .env and fill in real values. Never commit .env.

# --- Discord application credentials (Discord Developer Portal > your app) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Optional: set to a guild ID during development for instant command
# registration in that one server. Leave blank to register commands
# globally (can take up to ~1 hour to propagate to all servers).
DISCORD_DEV_GUILD_ID=

# Set to "true" ONLY after enabling "Message Content Intent" for this
# application in the Discord Developer Portal (Bot tab). Required for
# /summarize and the opt-in message-analysis feature. Every other command
# (setup, config, knowledge, ask, rules, privacy, forget, status, audit,
# feedback, report) works with this left "false".
ENABLE_MESSAGE_CONTENT_FEATURES=false

# --- Storage ---
DATABASE_FILE=./data/bot.sqlite3

# --- AI provider (optional) ---
# Leave ANTHROPIC_API_KEY blank to run every server in NullProvider mode:
# fully local keyword matching, nothing ever sent to an external API. Per
# server, an admin must ALSO explicitly run `/config ai enabled:true` before
# their questions are sent anywhere — setting a key here does not opt any
# server in by itself.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
